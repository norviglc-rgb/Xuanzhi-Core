{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/dev_task_packet.schema.json",
  "title": "Xuanzhi Development Task Packet",
  "description": "Structured handoff packet from Xuanzhi control plane to the development executor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "summary",
    "goal",
    "deliverable",
    "constraints",
    "risk_level",
    "recommended_executor",
    "execution_mode",
    "approval_mode",
    "reporting_requirements",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this packet schema."
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical identifier of the task."
    },
    "task_type": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized task category used for routing and execution."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Concise summary of the task."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Primary objective the executor should achieve."
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summary"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code_change",
            "specification",
            "bug_fix",
            "refactor",
            "prototype",
            "research_summary",
            "report",
            "mixed"
          ],
          "description": "Primary deliverable type."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Short description of the expected deliverable."
        },
        "artifact_expectations": {
          "type": "array",
          "description": "Optional list of expected artifact classes or outputs.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "description": "Execution constraints the development executor must respect.",
      "properties": {
        "must_do": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "must_not_do": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scope_included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scope_excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "quality_requirements": {
          "type": "array",
          "description": "Optional quality or delivery expectations.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": []
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ],
      "description": "Categorical risk level assigned by the control plane."
    },
    "risk_summary": {
      "type": "string",
      "description": "Optional concise explanation of the main risk concerns."
    },
    "recommended_executor": {
      "type": "string",
      "enum": [
        "xuanzhi",
        "claude_code",
        "fastgpt",
        "specialized_executor"
      ],
      "description": "Recommended executor chosen by the control plane."
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "direct",
        "delegated",
        "long_running_development",
        "workflow_execution",
        "review_only",
        "research_only"
      ],
      "description": "Execution mode selected for this task."
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "not_required",
        "governance_required",
        "human_required"
      ],
      "description": "Approval posture that applies before or during execution."
    },
    "repo_ref": {
      "type": "string",
      "description": "Optional repository reference if the task targets a specific repo."
    },
    "branch_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional repo and branch handling guidance for development execution.",
      "properties": {
        "branch_required": {
          "type": "boolean"
        },
        "branch_prefix": {
          "type": "string"
        },
        "commit_required": {
          "type": "boolean",
          "description": "Whether stage-level commits are expected."
        },
        "mr_expected": {
          "type": "boolean",
          "description": "Whether merge request flow is expected."
        }
      },
      "required": []
    },
    "context_refs": {
      "type": "array",
      "description": "Optional references to relevant lower-layer documents, specs, or artifacts.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Optional concrete success conditions.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reporting_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_required"
      ],
      "properties": {
        "summary_required": {
          "type": "boolean",
          "description": "Whether a structured summary is required on return."
        },
        "include_changed_files": {
          "type": "boolean",
          "description": "Whether changed file reporting is required."
        },
        "include_tests_run": {
          "type": "boolean",
          "description": "Whether test/build validation summary is required."
        },
        "include_blockers": {
          "type": "boolean",
          "description": "Whether blockers must be reported explicitly."
        },
        "include_next_step": {
          "type": "boolean",
          "description": "Whether the executor should propose a next step."
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the packet was created."
    },
    "created_by": {
      "type": "string",
      "description": "Optional creator identity, normally Xuanzhi."
    },
    "parent_task_id": {
      "type": "string",
      "description": "Optional parent task identifier for hierarchical work."
    },
    "epic_id": {
      "type": "string",
      "description": "Optional epic identifier for long-running work."
    },
    "milestone_id": {
      "type": "string",
      "description": "Optional milestone identifier for long-running work."
    },
    "artifact_refs": {
      "type": "array",
      "description": "Optional input artifact references relevant to execution.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "description": "Optional bounded execution note. Should remain concise."
    }
  }
}