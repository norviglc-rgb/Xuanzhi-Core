{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/dev_result_packet.schema.json",
  "title": "Xuanzhi Development Result Packet",
  "description": "Structured result packet returned from the development executor to the Xuanzhi control plane.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "summary",
    "deliverable_outcome",
    "changed_artifacts",
    "validation_result",
    "blockers",
    "next_step_recommendation",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this packet schema."
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical identifier of the parent task this result belongs to."
    },
    "trace_id": {
      "type": "string",
      "description": "Optional correlation identifier linking this result to the wider trace chain."
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partially_completed",
        "failed",
        "blocked",
        "cancelled"
      ],
      "description": "Overall execution status of the development task."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Concise summary of what was accomplished."
    },
    "deliverable_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summary"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code_change",
            "specification",
            "bug_fix",
            "refactor",
            "prototype",
            "research_summary",
            "report",
            "mixed"
          ],
          "description": "Primary deliverable type that was produced."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Short description of the deliverable outcome."
        },
        "artifacts_produced": {
          "type": "array",
          "description": "Optional list of actual artifacts produced.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "changed_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Summary of repository and file changes.",
      "properties": {
        "files_added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files_modified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files_deleted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "commit_refs": {
          "type": "array",
          "description": "Commit hashes or references created during execution.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "branch_ref": {
          "type": "string",
          "description": "Branch name if work was done on a branch."
        },
        "mr_ref": {
          "type": "string",
          "description": "Merge request reference if an MR was created."
        }
      },
      "required": []
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "description": "Summary of tests, builds, and other validation run.",
      "properties": {
        "tests_run": {
          "type": "boolean",
          "description": "Whether tests were executed."
        },
        "tests_passed": {
          "type": "boolean",
          "description": "Whether all tests passed."
        },
        "test_summary": {
          "type": "string",
          "description": "Optional summary of test results."
        },
        "build_run": {
          "type": "boolean",
          "description": "Whether build was executed."
        },
        "build_passed": {
          "type": "boolean",
          "description": "Whether build succeeded."
        },
        "build_summary": {
          "type": "string",
          "description": "Optional summary of build results."
        },
        "lint_run": {
          "type": "boolean",
          "description": "Whether lint was executed."
        },
        "lint_passed": {
          "type": "boolean",
          "description": "Whether lint check passed."
        },
        "security_scan_run": {
          "type": "boolean",
          "description": "Whether security scan was executed."
        },
        "security_scan_passed": {
          "type": "boolean",
          "description": "Whether security scan passed."
        },
        "validation_not_run_reason": {
          "type": "string",
          "description": "If validation was not run, explain why."
        }
      },
      "required": []
    },
    "blockers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Summary of blockers encountered.",
      "properties": {
        "has_blockers": {
          "type": "boolean",
          "description": "Whether any blockers exist."
        },
        "blocker_list": {
          "type": "array",
          "description": "List of blockers encountered.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "Description of the blocker."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "description": "Severity of the blocker."
              },
              "suggested_resolution": {
                "type": "string",
                "description": "Optional suggestion for how to resolve."
              }
            }
          }
        }
      },
      "required": [
        "has_blockers"
      ]
    },
    "next_step_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Recommended next steps for the control plane.",
      "properties": {
        "recommendation_type": {
          "type": "string",
          "enum": [
            "continue",
            "review_needed",
            "approval_needed",
            "replan_needed",
            "escalate",
            "stop"
          ],
          "description": "Type of next step recommended."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Reason for this recommendation."
        },
        "suggested_actions": {
          "type": "array",
          "description": "Optional list of concrete suggested actions.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "recommendation_type",
        "reason"
      ]
    },
    "risk_changes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Summary of any risk posture changes during execution.",
      "properties": {
        "original_risk_level": {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "final_risk_level": {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "risk_change_reason": {
          "type": "string",
          "description": "Explanation if risk level changed."
        }
      },
      "required": []
    },
    "execution_metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional execution metrics.",
      "properties": {
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "end_time": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "cost_estimate": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": []
    },
    "notes": {
      "type": "string",
      "description": "Optional bounded execution notes. Should remain concise."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this result packet was created."
    },
    "created_by": {
      "type": "string",
      "description": "Executor identity that produced this result."
    }
  }
}
